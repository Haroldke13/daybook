# Generated at install / runtime — never commit these
*.log
browser-profile/
__pycache__/
*.pyc
*.tmp
.DS_Store

# Never commit personal notes
notes/
exports/
*.md.bak

# --------------------------------------------------------------
# Added: secrets, local state and generated artefacts.
# NOTE: this does not untrack files already committed —
#       use git rm --cached for those.
# --------------------------------------------------------------
# Environment files, keys and credentials
.env
.env.*
!.env.example
*.pem
*.key

# Local databases
*.db
*.sqlite3
instance/

# Byte-compiled Python
*.py[cod]
